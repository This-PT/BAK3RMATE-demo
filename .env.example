# Copy this file to .env and fill in what you need. Every key is optional: without them the app still runs,
# with a rule-based assistant and the browser's own voice.

# --- AI chat and speech-to-text ---
OPENAI_API_KEY=
# A current OpenAI model that supports function calling. Leave empty for the default.
OPENAI_MODEL=

# --- Spoken replies ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Accounts ---
# "Continue with Google" appears once both are set (see the README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people open the app at, no trailing slash. Google sends them back here after sign-in.
PUBLIC_URL=http://localhost:8080
# Only this email may take over the data that existed before accounts. Empty = the first account to sign up does.
ADMIN_EMAIL=
# Proxies in front of the app: 1 locally. 2 for the server setup in DEPLOY.md (Caddy + the web server).
TRUST_PROXY_HOPS=1

# --- Only for a public server (see DEPLOY.md) ---
# The address people will type, no https:// and no slash. DNS must point at your server.
DOMAIN=
# A long random database password. Set it BEFORE the first start; it can't be changed this way afterwards.
POSTGRES_PASSWORD=
