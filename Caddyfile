# Caddy: HTTPS in front of the app. {$DOMAIN} comes from .env (for example app.example.com).
# Visitors reach Caddy, Caddy hands requests to the app's web server on the private network.
{$DOMAIN} {
	encode gzip
	reverse_proxy frontend:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
